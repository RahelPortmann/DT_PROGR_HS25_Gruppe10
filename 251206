import os
import pandas as pd
import ifcopenshell
import tkinter as tk
from tkinter import filedialog
from datetime import date


# --------------------------------------------------------
# 1) IFC-Datei auswählen (mit macOS Fix)
# --------------------------------------------------------

def pick_ifc_file() -> str:
    root = tk.Tk()
    root.withdraw()
    root.call('wm', 'attributes', '.', '-topmost', True)  # macOS Fix
    filepath = filedialog.askopenfilename(
        title="Wähle eine IFC-Datei aus",
        filetypes=[("IFC files", "*.ifc")]
    )
    root.destroy()
    return filepath


# --------------------------------------------------------
# 2) IFC einlesen und Materialien + Mengen extrahieren
# --------------------------------------------------------

def load_ifc_materials(ifc_path: str) -> pd.DataFrame:
    ifc = ifcopenshell.open(ifc_path)
    elements = []

    for product in ifc.by_type("IfcBuildingElement"):
        mats = product.HasAssociations
        if not mats:
            continue

        # Material finden
        material_name = None
        for assoc in mats:
            if assoc.is_a("IfcRelAssociatesMaterial"):
                mat = assoc.RelatingMaterial
                if mat.is_a("IfcMaterial"):
                    material_name = mat.Name
                elif mat.is_a("IfcMaterialLayerSet"):
                    try:
                        material_name = mat.MaterialLayers[0].Material.Name
                    except:
                        pass

        if not material_name:
            continue

        # Mengen (Volume)
        volume = None
        quantity_sets = product.IsDefinedBy
        if quantity_sets:
            for rel in quantity_sets:
                if rel.is_a("IfcRelDefinesByProperties"):
                    props = rel.RelatingPropertyDefinition
                    if props.is_a("IfcElementQuantity"):
                        for q in props.Quantities:
                            if q.is_a("IfcQuantityVolume"):
                                volume = q.VolumeValue

        if volume is None:
            continue

        elements.append({
            "Material_raw": str(material_name),
            "Menge": float(volume),
            "Einheit": "m3"
        })

    return pd.DataFrame(elements)


# --------------------------------------------------------
# 3) KBOB laden
# --------------------------------------------------------

# -> DATA_DIR liegt im Projektordner, NICHT darüber!
DATA_DIR = os.path.join(os.path.dirname(__file__), "data")
KBOB_CSV = os.path.join(DATA_DIR, "kbob_materialien.csv")


def load_kbob(path: str) -> pd.DataFrame:
    df = pd.read_csv(path, encoding="utf-8")
    df["Material"] = df["Material"].astype(str).str.strip()
    return df


# --------------------------------------------------------
# 4) Mapping
# --------------------------------------------------------

def build_mapping() -> dict:
    return {
        "Concrete": "Beton",
        "Beton": "Beton",
        "Stahl": "Stahl",
        "Steel": "Stahl",
        "Holz": "Holz",
        "Timber": "Holz",
        "Wood": "Holz",
    }


def apply_mapping(df: pd.DataFrame, mapping: dict) -> pd.DataFrame:
    df = df.copy()
    df["Material"] = df["Material_raw"].map(mapping).fillna(df["Material_raw"])
    return df


# --------------------------------------------------------
# 5) Merge + CO2-Berechnung
# --------------------------------------------------------

def merge_and_compute(df_ifc: pd.DataFrame, df_kbob: pd.DataFrame) -> pd.DataFrame:
    merged = pd.merge(df_ifc, df_kbob, on="Material", how="left")
    merged["CO2_total_kg"] = merged["Menge"] * merged["CO2_Faktor"]
    return merged


# --------------------------------------------------------
# 6) Export als CSV mit Datum
# --------------------------------------------------------

def export_results(df: pd.DataFrame):
    today_str = date.today().isoformat()
    export_path = os.path.join(DATA_DIR, f"ergebnis_co2_{today_str}.csv")
    df.to_csv(export_path, index=False, encoding="utf-8")
    print(f"\nCSV exportiert: {export_path}")


# --------------------------------------------------------
# 7) Hauptprogramm
# --------------------------------------------------------

if __name__ == "__main__":

    print("\n📁 Bitte IFC-Datei auswählen ...")
    ifc_path = pick_ifc_file()

    if not ifc_path:
        print("⚠️ Keine Datei ausgewählt. Stoppe.")
        exit()

    print(f"➡️ Eingelesen: {ifc_path}\n")

    # IFC laden
    print("🔍 Lese IFC-Materialien ...")
    ifc_df = load_ifc_materials(ifc_path)
    print(ifc_df.head().to_string(index=False))

    # KBOB laden
    print("\n📘 Lade KBOB-Materialtabelle ...")
    kbob = load_kbob(KBOB_CSV)

    # Mapping anwenden
    mapping = build_mapping()
    mapped_df = apply_mapping(ifc_df, mapping)

    print("\n🔧 IFC mit KBOB-Mapping:")
    print(mapped_df.head().to_string(index=False))

    # Merge + Berechnung
    result = merge_and_compute(mapped_df, kbob)

    print("\n🌍 Ergebnis (erste Zeilen):")
    print(result.head().to_string(index=False))

    # CO2-Summe pro Material
    summe = (
        result.groupby("Material", as_index=False)["CO2_total_kg"]
        .sum()
        .sort_values("CO2_total_kg", ascending=False)
    )

    print("\n📊 CO2-Summe pro Material:")
    print(summe.to_string(index=False))

    # Export
    export_results(result)

    print("\nFERTIG ✔️")

